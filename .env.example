# ─────────────────────────────────────────────────────────────
# Tredie — copy to .env.local and fill in what you have.
# Everything is optional: the app runs on testnet with a SQLite
# file and the built-in portrait renderer — no database server,
# no image model, no storage bucket.
# ─────────────────────────────────────────────────────────────

# ── Persistence: SQLite (embedded, Node's node:sqlite) ───────
# The database is a single file. Local default: ./data/tredie.db.
# Cloud Run: point this at a writable filesystem and keep
# min-instances=1 — an instance-local file is not a network DB.
# TREDIE_DB_FILE=/app/data/tredie.db

# ── Wallet PIN sessions ──────────────────────────────────────
# Signs the 30-day "unlock" cookie. Set it to something long and
# secret. Without it, dev boots with a per-process random key and
# sessions reset on every restart (fine locally, annoying in prod).
# TREDIE_PIN_COOKIE_SECRET=change-me-to-a-long-random-string

# ── Dormant: portraits are static assets ────────────────────
# Tredie has no image model and uploads nothing: a portrait is the
# species WebP in public/tredie plus an optional accessory, composed
# at render time. These variables are accepted but unused, kept so the
# storage/generation service boundaries can be revived without a rewrite.
#
# GCS_BUCKET=tredie-images
# GOOGLE_CLOUD_PROJECT=my-project
# GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/tredie-images
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json
# GCS_CLIENT_EMAIL=
# GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# IMAGE_GENERATION_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# IMAGE_GENERATION_PROVIDER=openai
# IMAGE_GENERATION_MODEL=gpt-image-1
# IMAGE_GENERATION_SIZE=1024x1024

# ── Stellar ─────────────────────────────────────────────────
# testnet (default) or public.
STELLAR_NETWORK=testnet
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org
# Settlement asset. USDC per the spec; XLM is the walkable
# testnet alternative, since a fresh Testnet account holds no USDC.
# STELLAR_ASSET_CODE=USDC
# Circle's testnet USDC trustline. Confirm before mainnet use.
# STELLAR_USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# ── Cloud Run ──────────────────────────────────────────────
# Cloud Run injects PORT and expects the app to bind 0.0.0.0.
# PORT=8080
# HOSTNAME=0.0.0.0